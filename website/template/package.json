{
  "name": "website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A business website on Hono: served from its own machine while it is built, pre-rendered and shipped to the edge when it is published.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run content && npm run css && tsx src/server.ts",
    "content": "node scripts/content.mjs --verbose",
    "css": "tailwindcss -i styles/input.css -o static/site.css --minify",
    "css:watch": "tailwindcss -i styles/input.css -o static/site.css --watch=always",
    "build": "tsx scripts/build.ts",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit -p .",
    "audit": "tt-crawl audit http://localhost:3000 --out raw/web/_audit.md --no-external",
    "deploy": "python3 scripts/deploy.py"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "hono": "^4.13.7",
    "marked": "^18.0.11",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  }
}
